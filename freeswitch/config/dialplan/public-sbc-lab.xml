<include>
  <context name="public">

    <!-- 2xxx: Co-Pilot bridge — ring agent1 + SIPREC fork to gateway -->
    <extension name="copilot_bridge">
      <condition field="destination_number" expression="^(2[0-9]{3})$">
        <action application="answer"/>
        <!-- Fork caller audio to gateway copilot -->
        <action application="set" data="res=${uuid_audio_fork ${uuid} start $${media_gateway_ws_base}/siprec?role=caller&amp;call_id=${uuid} mono 16000}"/>
        <!-- Bridge to agent — customer and agent talk, copilot observes caller side -->
        <action application="bridge" data="sofia/softphone/agent1%$${ext_ip}"/>
      </condition>
    </extension>

    <!-- 21xx: Co-Pilot auto-answer — AI answers, SIPREC observes -->
    <extension name="copilot_auto">
      <condition field="destination_number" expression="^(21[0-9]{2})$">
        <action application="answer"/>
        <action application="set" data="res=${uuid_audio_fork ${uuid} start $${media_gateway_ws_base}/siprec?role=caller&amp;call_id=${uuid} mono 16000}"/>
        <action application="park"/>
      </condition>
    </extension>

    <!-- 1xxx: Interactive AI Agent -->
    <extension name="ai_agent">
      <condition field="destination_number" expression="^(1[0-9]{3})$">
        <action application="answer"/>
        <action application="set" data="res=${uuid_audio_fork ${uuid} start $${media_gateway_ws} mono 16000}"/>
        <action application="park"/>
      </condition>
    </extension>

    <!-- 3xxx: Human queue — hold audio -->
    <extension name="human_queue">
      <condition field="destination_number" expression="^(3[0-9]{3})$">
        <action application="answer"/>
        <action application="playback" data="local_stream://moh"/>
      </condition>
    </extension>

    <!-- Fallback: AI agent for any other number -->
    <extension name="fallback">
      <condition field="destination_number" expression="^(.+)$">
        <action application="answer"/>
        <action application="set" data="res=${uuid_audio_fork ${uuid} start $${media_gateway_ws} mono 16000}"/>
        <action application="park"/>
      </condition>
    </extension>

  </context>
</include>
