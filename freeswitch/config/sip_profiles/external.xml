<profile name="external">
  <gateways>
    <!-- SBC trunk for outbound call origination.
         Configure via K8s ConfigMap / env vars at deploy time.
         Set sbc_register=true if the SBC requires REGISTER. -->
    <gateway name="sbc">
      <param name="proxy" value="$${sbc_address}"/>
      <param name="register" value="$${sbc_register}"/>
      <param name="username" value="$${sbc_username}"/>
      <param name="password" value="$${sbc_password}"/>
      <param name="realm" value="$${sbc_realm}"/>
      <param name="caller-id-in-from" value="true"/>
      <param name="retry-seconds" value="30"/>
      <param name="ping" value="25"/>
      <param name="register-transport" value="udp"/>
    </gateway>
  </gateways>

  <settings>
    <!-- SIP binding — SBC-facing interface -->
    <param name="sip-ip" value="$${local_ip_v4}"/>
    <param name="sip-port" value="5060"/>
    <param name="ext-sip-ip" value="$${external_sip_ip}"/>

    <!-- RTP addressing -->
    <param name="rtp-ip" value="$${local_ip_v4}"/>
    <param name="ext-rtp-ip" value="$${external_rtp_ip}"/>

    <!-- Dialplan routing -->
    <param name="context" value="public"/>
    <param name="dialplan" value="XML"/>

    <!-- Authentication — IP ACL for dev, digest auth for production.
         Set auth-calls=true and configure directory for digest mode. -->
    <param name="auth-calls" value="$${sbc_auth_calls}"/>
    <param name="accept-blind-auth" value="true"/>
    <param name="apply-inbound-acl" value="sbc-trusted"/>

    <!-- Codec negotiation — standard SBC codecs.
         FreeSWITCH transcodes to L16 internally for mod_audio_fork. -->
    <param name="inbound-codec-prefs" value="PCMU,PCMA,G722"/>
    <param name="outbound-codec-prefs" value="PCMU,PCMA,G722"/>
    <param name="inbound-codec-negotiation" value="generous"/>

    <!-- NAT traversal — required for SBC peering across NAT -->
    <param name="aggressive-nat-detection" value="true"/>
    <param name="NDLB-force-rport" value="safe"/>
    <param name="NDLB-received-in-nat-reg-contact" value="true"/>

    <!-- Session timers (RFC 4028) — SBCs expect these -->
    <param name="enable-timer" value="true"/>
    <param name="session-timeout" value="1800"/>
    <param name="minimum-session-expires" value="120"/>

    <!-- RTP settings -->
    <param name="rtp-timeout-sec" value="300"/>
    <param name="rtp-hold-timeout-sec" value="1800"/>

    <!-- DTMF — RFC 2833 is the SBC standard -->
    <param name="rfc2833-pt" value="101"/>
    <param name="dtmf-type" value="rfc2833"/>

    <!-- Pass SIP headers to dialplan as channel variables -->
    <param name="pass-callee-id" value="true"/>
  </settings>
</profile>
