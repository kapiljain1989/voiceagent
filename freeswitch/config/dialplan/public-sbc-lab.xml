<include>
  <context name="public">

    <!-- 2xxx: Co-Pilot queue — agent picks via Console WebRTC -->
    <extension name="copilot_bridge">
      <condition field="destination_number" expression="^(2[0-9]{3})$">
        <action application="answer"/>
        <!-- Fork caller audio to gateway for copilot + WebRTC bridge -->
        <action application="set" data="res=${uuid_audio_fork ${uuid} start ws://gateway:8080/siprec?role=caller&amp;call_id=${uuid} mono 16000}"/>
        <!-- conference keeps the media engine active (reads caller audio continuously) -->
        <action application="conference" data="queue_${uuid}@default"/>
      </condition>
    </extension>

    <!-- 21xx: Co-Pilot auto-answer — hold music briefly, then SIPREC -->
    <extension name="copilot_auto">
      <condition field="destination_number" expression="^(21[0-9]{2})$">
        <action application="answer"/>
        <!-- Brief welcome tone before AI pipeline starts -->
        <action application="playback" data="tone_stream://%(200,0,400);%(200,100,400)"/>
        <action application="set" data="res=${uuid_audio_fork ${uuid} start ws://gateway:8080/siprec?role=caller&amp;call_id=${uuid} mono 16000}"/>
        <action application="park"/>
      </condition>
    </extension>

    <!-- 1xxx: Interactive AI Agent -->
    <extension name="ai_agent">
      <condition field="destination_number" expression="^(1[0-9]{3})$">
        <action application="answer"/>
        <action application="set" data="res=${uuid_audio_fork ${uuid} start ws://gateway:8080/ws mono 16000}"/>
        <action application="park"/>
      </condition>
    </extension>

    <!-- 3xxx: Human queue — hold audio -->
    <extension name="human_queue">
      <condition field="destination_number" expression="^(3[0-9]{3})$">
        <action application="answer"/>
        <action application="playback" data="local_stream://moh"/>
      </condition>
    </extension>

    <!-- Fallback: AI agent for any other number -->
    <extension name="fallback">
      <condition field="destination_number" expression="^(.+)$">
        <action application="answer"/>
        <action application="set" data="res=${uuid_audio_fork ${uuid} start ws://gateway:8080/ws mono 16000}"/>
        <action application="park"/>
      </condition>
    </extension>

  </context>
</include>
