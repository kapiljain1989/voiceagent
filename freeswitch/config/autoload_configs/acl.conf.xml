<configuration name="acl.conf" description="Network ACLs">
  <network-lists>
    <!-- Trusted SBC peers — add your SBC IP ranges here.
         Default: allow all private ranges + localhost for local dev. -->
    <list name="sbc-trusted" default="deny">
      <!-- RFC1918 private ranges — covers local dev, Docker, KinD -->
      <node type="allow" cidr="10.0.0.0/8"/>
      <node type="allow" cidr="172.16.0.0/12"/>
      <node type="allow" cidr="192.168.0.0/16"/>
      <node type="allow" cidr="127.0.0.0/8"/>
      <!-- Docker Desktop NAT gateway -->
      <node type="allow" cidr="100.0.0.0/8"/>
      <node type="allow" cidr="143.0.0.0/8"/>
    </list>
  </network-lists>
</configuration>
